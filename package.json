{
  "name": "steam-engine-reconstruction",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host",
    "prebuild": "npm run i18n:review:check && npm run i18n:critique-queue",
    "build": "node tools/build.mjs",
    "build:fast": "node tools/build.mjs --fast",
    "build:cloudflare": "node tools/build.mjs --cloudflare-artifact",
    "build:sharded": "node tools/build-sharded.mjs",
    "build:broker": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/iis-slot-broker/publish-broker.ps1",
    "build:partial": "node tools/build-partial.mjs",
    "preview": "vite preview",
    "preview:playwright": "node tools/playwright-static-server.mjs",
    "blog:import": "node tools/import-blog.mjs",
    "ads:validate": "node tools/validate-advertising-config.mjs",
    "validate:public": "node --experimental-strip-types --no-warnings tools/validate-public-repository.mjs",
    "i18n:materialize-nynorsk": "node tools/materialize-nynorsk.mjs",
    "i18n:review": "node tools/generate-translation-review.mjs",
    "i18n:review:check": "node tools/generate-translation-review.mjs --check --cache",
    "i18n:critique-queue": "node tools/translation-critique-queue.mjs validate",
    "i18n:qc:tr": "node tools/test-turkish-translation-qc.mjs",
    "i18n:qc:fi": "node tools/check-finnish-draft.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:recovered": "npm run typecheck:recovered:main && npm run typecheck:recovered:tcr",
    "typecheck:recovered:main": "tsc --project reference/reconstructed/cleaned-site/ts",
    "typecheck:recovered:tcr": "tsc --project reference/reconstructed/cleaned-site/ts/tcr",
    "test:broker": "dotnet test tools/iis-slot-broker.tests/SteamEngineIisSlotBroker.Tests.csproj --no-restore",
    "pretest": "npm run i18n:review:check && npm run i18n:critique-queue",
    "test": "vitest run",
    "test:routes": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-route-contract.ps1",
    "test:links": "node tools/check-generated-links.mjs",
    "test:cloudflare": "node tools/test-cloudflare-pages-artifact.mjs",
    "audit:links": "node tools/audit-links.mjs",
    "test:watch": "vitest",
    "test:e2e": "node tools/run-playwright-e2e.mjs",
    "test:a11y": "node tools/run-playwright-e2e.mjs tests/e2e/accessibility.spec.ts",
    "test:a11y:baseline": "node tools/update-accessibility-baseline.mjs",
    "i18n:qc:tr:browser": "node tools/run-playwright-e2e.mjs tests/e2e/turkish-qc.spec.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.13.0",
    "jsdom": "^28.1.0",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
