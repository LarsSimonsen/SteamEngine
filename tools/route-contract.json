{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "version": 2,
    "specification": "SITE-STRUCTURE.md",
    "urlPolicy": {
        "rootPath": "/",
        "pageStyle": "slashless-extensionless",
        "trailingSlashRedirectRequired": false,
        "implementationSuffixRedirectRequired": true,
        "implementationSuffixes": [
            ".asp",
            ".html"
        ],
        "localePrefixCaseSensitive": true
