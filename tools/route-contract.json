        "localizedPages": "public/<locale>/<page>.html",
        "comparisonPages": "public/compare/<category>.html",
        "localizedComparisonPages": "public/<locale>/compare/<category>.html",
        "catalogDetails": "public/catalog/<category>/<slug>.html",
        "localizedCatalogDetails": "public/<locale>/catalog/<category>/<slug>.html",
        "blogPages": "public/blog/<path>/index.html",
        "legacyPages": "public/old/<page>.html",
        "localIisConfig": "tools/local-iis-web.config",
        "productionIncludesLocalIisConfig": false
    },
    "navigation": {
        "general": [
            "/catalog",
            "/blog",
            "/about"
