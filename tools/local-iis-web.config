<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="SteamEngineRootImplementationSuffixRedirect" stopProcessing="true">
                    <match url="^(?:default\.asp|index\.html)$" />
                    <action type="Redirect" url="/" redirectType="Permanent" appendQueryString="true" />
                </rule>

                <rule name="SteamEngineWireWizAspRedirect" stopProcessing="true">
                    <match url="^wirewiz\.asp$" />
                    <action type="Redirect" url="wirewiz" redirectType="Permanent" appendQueryString="false" />
                </rule>

                <rule name="SteamEngineImplementationSuffixRedirect" stopProcessing="true">
                    <match
                        url="^((?:batt|coil|converter|juice|modrange|ohm|tcr|wirewiz))\.(?:asp|html)$" />
                    <action type="Redirect" url="{R:1}" redirectType="Permanent" appendQueryString="true" />
                </rule>

                <rule name="SteamEngineUnsupportedImplementationSuffix" stopProcessing="true">
                    <match url="^(.+)\.(?:asp|html)$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineLocalizedRootPageTrailingSlashUnsupported" stopProcessing="true">
                    <match
                        url="^(nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineLocalizedRootPage" stopProcessing="true">
                    <match
                        url="^(nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)$" />
                    <action type="Rewrite" url="{R:1}.html" />
                </rule>

                <rule name="SteamEngineLocalizedCalculatorPageTrailingSlashUnsupported" stopProcessing="true">
                    <match
                        url="^(nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/(batt|coil|converter|juice|modrange|ohm|tcr|wirewiz)/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineLocalizedComparisonTrailingSlashUnsupported" stopProcessing="true">
                    <match
                          url="^(nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/compare/(batteries|materials|mods)/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineLocalizedCatalogDetailTrailingSlashUnsupported" stopProcessing="true">
                    <match
                        url="^((?:nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/catalog/(?:concept|battery|mod|material)/[^/.]+)/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineLocalizedCatalogShortcutTrailingSlashUnsupported" stopProcessing="true">
                    <match
                        url="^(?:nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/catalog/(?:concept|battery|mod|material)/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineLocalizedCatalogPageTrailingSlashUnsupported" stopProcessing="true">
                    <match
                        url="^(?:nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/catalog/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineLocalizedCatalogConceptShortcut" stopProcessing="true">
                    <match
                        url="^(nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/catalog/concept$" />
                    <action type="Redirect" url="{R:1}/catalog#concepts" redirectType="Permanent"
                        appendQueryString="true" />
                </rule>

                <rule name="SteamEngineLocalizedCatalogBatteryShortcut" stopProcessing="true">
                    <match
                        url="^(nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/catalog/battery$" />
                    <action type="Redirect" url="{R:1}/catalog#batteries" redirectType="Permanent"
                        appendQueryString="true" />
                </rule>

                <rule name="SteamEngineLocalizedCatalogModShortcut" stopProcessing="true">
                    <match
                        url="^(nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/catalog/mod$" />
                    <action type="Redirect" url="{R:1}/catalog#mods" redirectType="Permanent"
                        appendQueryString="true" />
                </rule>

                <rule name="SteamEngineLocalizedCatalogMaterialShortcut" stopProcessing="true">
                    <match
                        url="^(nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/catalog/material$" />
                    <action type="Redirect" url="{R:1}/catalog#materials" redirectType="Permanent"
                        appendQueryString="true" />
                </rule>

                <rule name="SteamEngineLocalizedCatalogPage" stopProcessing="true">
                    <match
                        url="^(nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/catalog$" />
                    <action type="Rewrite" url="{R:1}/catalog.html" />
                </rule>

                <rule name="SteamEngineLocalizedSlugPage" stopProcessing="true">
                    <match
                        url="^((?:nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/catalog/(?:concept|battery|mod|material))/([^/.]+)$" />
                    <action type="Rewrite" url="{R:1}/{R:2}.html" />
                </rule>

                <rule name="SteamEngineLocalizedCalculatorPage" stopProcessing="true">
                    <match
                        url="^(nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/(batt|coil|converter|juice|modrange|ohm|tcr|wirewiz)$" />
                    <action type="Rewrite" url="{R:1}/{R:2}.html" />
                </rule>

                <rule name="SteamEngineLocalizedComparison" stopProcessing="true">
                    <match
                          url="^(nb|nn|zh-Hans|ar|es|es-419|fr|pl|uk|it|vi|de|sv|da|is|hi|bn|pt|pt-BR|ja|ko|el|tr|id|fi)/compare/(batteries|materials|mods)$" />
                    <action type="Rewrite" url="{R:1}/compare/{R:2}.html" />
                </rule>

                <rule name="SteamEngineRootPageTrailingSlashUnsupported" stopProcessing="true">
                    <match url="^(about|privacy|batt|coil|converter|juice|modrange|ohm|tcr|wirewiz)/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineComparisonTrailingSlashUnsupported" stopProcessing="true">
                    <match url="^compare/(batteries|materials|mods)/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineBlogTrailingSlashUnsupported" stopProcessing="true">
                    <match url="^blog(?:/.*)?/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineBlogRoot" stopProcessing="true">
                    <match url="^blog$" />
                    <action type="Rewrite" url="blog/index.html" />
                </rule>

                <rule name="SteamEngineLegacyTrailingSlashUnsupported" stopProcessing="true">
                    <match url="^old(?:/[^/.]+)?/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineCatalogDetailTrailingSlashUnsupported" stopProcessing="true">
                    <match url="^catalog/(?:concept|battery|mod|material)/[^/.]+/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineCatalogShortcutTrailingSlashUnsupported" stopProcessing="true">
                    <match url="^catalog/(?:concept|battery|mod|material)/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineCatalogPageTrailingSlashUnsupported" stopProcessing="true">
                    <match url="^catalog/$" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                        statusDescription="Not Found" />
                </rule>

                <rule name="SteamEngineCatalogConceptShortcut" stopProcessing="true">
                    <match url="^catalog/concept$" />
                    <action type="Redirect" url="catalog#concepts" redirectType="Permanent"
                        appendQueryString="true" />
                </rule>

                <rule name="SteamEngineCatalogBatteryShortcut" stopProcessing="true">
                    <match url="^catalog/battery$" />
                    <action type="Redirect" url="catalog#batteries" redirectType="Permanent"
                        appendQueryString="true" />
                </rule>

                <rule name="SteamEngineCatalogModShortcut" stopProcessing="true">
                    <match url="^catalog/mod$" />
                    <action type="Redirect" url="catalog#mods" redirectType="Permanent"
                        appendQueryString="true" />
                </rule>

                <rule name="SteamEngineCatalogMaterialShortcut" stopProcessing="true">
                    <match url="^catalog/material$" />
                    <action type="Redirect" url="catalog#materials" redirectType="Permanent"
                        appendQueryString="true" />
                </rule>

                <rule name="SteamEngineCatalogPage" stopProcessing="true">
                    <match url="^catalog$" />
                    <action type="Rewrite" url="catalog.html" />
                </rule>

                <rule name="SteamEngineBlogPaginationPage" stopProcessing="true">
                    <match url="^blog/page/([1-9][0-9]*)$" />
                    <action type="Rewrite" url="blog/page/{R:1}/index.html" />
                </rule>

                <rule name="SteamEngineBlogArticlePage" stopProcessing="true">
                    <match url="^blog/([0-9]{4}/[0-9]{2}/[0-9]{2}/[a-z0-9]+(?:-[a-z0-9]+)*)$" />
                    <action type="Rewrite" url="blog/{R:1}/index.html" />
                </rule>

                <rule name="SteamEngineLegacyIndex" stopProcessing="true">
                    <match url="^old$" />
                    <action type="Rewrite" url="old/index.html" />
                </rule>

                <rule name="SteamEngineLegacyPage" stopProcessing="true">
                    <match url="^old/([^/.]+)$" />
                    <action type="Rewrite" url="old/{R:1}.html" />
                </rule>

                <rule name="SteamEngineSlugPage" stopProcessing="true">
                    <match url="^(catalog/(?:concept|battery|mod|material))/([^/.]+)$" />
                    <action type="Rewrite" url="{R:1}/{R:2}.html" />
                </rule>

                <rule name="SteamEngineCalculatorPage" stopProcessing="true">
                    <match url="^(about|privacy|batt|coil|converter|juice|modrange|ohm|tcr|wirewiz)$" />
                    <action type="Rewrite" url="{R:1}.html" />
                </rule>

                <rule name="SteamEngineComparison" stopProcessing="true">
                    <match url="^compare/(batteries|materials|mods)$" />
                    <action type="Rewrite" url="compare/{R:1}.html" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
